# AI Config
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_SECONDS=45
MAX_CALLS_PER_MINUTE=10

# Security & Auth
JWT_SECRET=food-ai-secret-key-change-in-production-123456
JWT_ALGORITHM=HS256
JWT_EXPIRATION_SECONDS=604800

# Database (SQLite local por defecto)
DATABASE_PATH=data/app.db

# Supabase Cloud Database (Descomentar para usar Supabase en la nube)
# SUPABASE_URL=https://tu-proyecto.supabase.co
# SUPABASE_KEY=tu_supabase_service_role_o_anon_key
